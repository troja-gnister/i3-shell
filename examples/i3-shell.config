# Example ~/.config/i3/config for i3-shell.
#
# i3-shell reads your real i3 config; it has no settings of its own. This file
# is a working example of the subset it understands, and a note of what it
# ignores. Anything not listed here is parsed, warned about in the shell log,
# and skipped -- an unsupported line never stops the rest of the config loading.
#
#   journalctl --user -f -o cat /usr/bin/gnome-shell | grep i3-shell

set $mod Mod4
set $term kitty

# --------------------------------------------
# WORKSPACES
# --------------------------------------------
# Named workspaces become the panel pills, in this order.
set $ws1 "1:I"
set $ws2 "2:II"
set $ws3 "3:III"
set $ws4 "4:IV"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4

# i3-shell replaces i3bar, so the whole bar block is ignored -- with one
# exception. strip_workspace_numbers renders the pills without the leading
# number, so "1:I" is drawn as "I". The name itself is unchanged, so both
# `workspace number $ws1` above and a literal `workspace 1:I` still resolve.
# Remove this block to see the numbers again. GNOME's overview follows the
# pills, because i3-shell writes the same labels into workspace-names.
bar {
    strip_workspace_numbers yes
}

# --------------------------------------------
# WINDOWS
# --------------------------------------------
bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+Shift+q kill

bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# Arrow keys work alongside the home row.
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# How the next window splits the focused tile.
bindsym $mod+h split h
bindsym $mod+v split v

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+a focus parent
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# --------------------------------------------
# MODES
# --------------------------------------------
mode "resize" {
    bindsym j resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# --------------------------------------------
# COLOURS
# --------------------------------------------
# Leave client.focused unset and i3-shell paints focused chrome -- the active
# workspace pill, and window borders from phase 3 -- with your GNOME accent
# colour, following it live when you change it in Settings. Set the line to
# pin a colour instead: the config always wins over the accent.
#
#   client.focused  #13BEAA  #13BEAA  #FFFFFF  #13BEAA  #13BEAA
#
# The other states are never taken from the accent. urgent in particular must
# stay a warning colour.
#
# class                  border   background text     indicator child_border
client.focused_inactive  #8C8C8C  #4C4C4C    #FFFFFF  #4C4C4C   #8C8C8C
client.unfocused         #4C4C4C  #222222    #888888  #292D2E   #222222
client.urgent            #EC69A0  #DB3279    #FFFFFF  #DB3279   #DB3279

default_border pixel 2

# --------------------------------------------
# RUNNING THINGS
# --------------------------------------------
# exec works in bindings and runs through /bin/sh, so ~ and $VARS expand.
# There is no launcher built in: bind whatever you use. A GNOME extension such
# as ArcMenu can also claim a key directly, as long as your config does not
# bind it -- i3-shell only grabs keys the config asks for.
bindsym $mod+Shift+e exec --no-startup-id gnome-session-quit --logout

# --------------------------------------------
# NOT SUPPORTED YET
# --------------------------------------------
# Parsed and skipped with a warning, so they are safe to leave in a config
# shared with real i3:
#
#   bar { ... }              the GNOME panel carries the pills instead
#   assign / for_window      for_window is parsed; it applies from phase 4
#   bindcode                 only bindsym is grabbed
#   marks, scratchpad        outside v1
#   gaps                     outside v1
#   exec at top level        only exec inside a binding runs
#
# GNOME notes:
#   * Windows on a secondary output are sticky under GNOME's default, and
#     i3-shell does not tile sticky windows. To tile across displays:
#       gsettings set org.gnome.mutter workspaces-only-on-primary false
#   * IBus claims <Super>space and <Super>semicolon through its own settings,
#     which i3-shell's override scan does not cover. If those keys do nothing,
#     clear them:
#       gsettings set org.freedesktop.ibus.general.hotkey triggers "@as []"
#       gsettings set org.freedesktop.ibus.panel.emoji hotkey "['<Super>period']"
